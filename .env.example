# 运行 npm run setup 时会自动生成 NUXT_DATABASE_URL 和 NUXT_SESSION_PASSWORD，写入 .env

# MySQL 连接串（项目内实例默认端口 3307）
NUXT_DATABASE_URL=mysql://handbook:密码@127.0.0.1:3307/handbook

# 登录会话的加密密钥，至少 32 位随机字符
NUXT_SESSION_PASSWORD=

# ---- AI 模拟面试官（OpenAI 兼容接口）----
# 可以不填 NUXT_AI_API_KEY：这时用户在面试面板里填写自己的 Key 也能使用
# 默认使用 Kimi（Moonshot），API Key 在 https://platform.moonshot.cn 的控制台创建
NUXT_AI_API_KEY=
NUXT_AI_BASE_URL=https://api.moonshot.cn/v1
# 可用的模型名以控制台为准，后台"AI 设置"页可以一键检查
NUXT_AI_MODEL=kimi-k2-turbo-preview
# 站点 Key 每个用户 24 小时内最多调用几次（用户在页面上填了自己的 Key 时不受限制）
NUXT_AI_DAILY_LIMIT=30
# 用户自带 Key 时只能选预设的服务商（Kimi、DeepSeek、通义、智谱、硅基流动、OpenAI、OpenRouter）；
# 要允许其他 OpenAI 兼容服务，在这里加域名，逗号分隔，只支持 https
NUXT_AI_EXTRA_HOSTS=

# 换成其他服务商时只需修改上面三项，例如：
# DeepSeek：NUXT_AI_BASE_URL=https://api.deepseek.com/v1  NUXT_AI_MODEL=deepseek-chat

# ---- 发信（注册邮箱验证码）----
# 配置后注册需要邮箱验证码（后台"用户"页可以临时关闭）。例如 QQ 邮箱：在邮箱设置里开启 SMTP 服务并生成授权码
# 云服务器一般封了 25 端口，用 465（SSL）或 587
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=465
NUXT_MAIL_USER=
NUXT_MAIL_PASS=
# 发件人显示，例如：全栈面试手册 <xxx@qq.com>，不填时用 NUXT_MAIL_USER
NUXT_MAIL_FROM=
# 本地开发想试注册验证码又不想真发邮件时，填一个目录，邮件会写成 JSON 文件放在这里
# NUXT_MAIL_OUTBOX_DIR=.data/outbox

# ---- 问手册（RAG）的向量模型 ----
# OpenAI 兼容的 /embeddings 接口，默认硅基流动的 BAAI/bge-m3。不填 Key 时只用关键词检索，问手册照样能用
# 填好后重启服务，会在后台给所有题目生成向量（进度在后台"知识库"里看）
NUXT_EMBED_API_KEY=
# NUXT_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# NUXT_EMBED_MODEL=BAAI/bge-m3
